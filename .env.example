# ─────────────────────────────────────────────────────────────────────────────────────────
# Oops, I Traveled Again! — environment variables
#
# Copy to .env.local (git-ignored) for local work; set the same names in your host
# (e.g. Vercel → Project → Settings → Environment Variables) for production.
#
# EVERYTHING BELOW IS OPTIONAL FOR LOCAL DEVELOPMENT. With no variables at all, `npm run dev`
# runs with an embedded PostgreSQL, a bundled country-level atlas map, an offline city search
# and local photo storage. Add providers as you need them.
#
# Secrets (anything not marked PUBLIC) must never be committed or exposed to the browser.
# ─────────────────────────────────────────────────────────────────────────────────────────

# ── Site ────────────────────────────────────────────────────────────────────────────────
# Canonical public URL (used for sitemap, canonical links, social previews).
SITE_URL=http://localhost:3000
# Shown on the passport and About page.
OWNER_NAME=The Traveler

# Sample content (DEMO-stamped places, trips and bucket-list items).
# Default: shown in development, hidden in production. Remove it any time from the dashboard.
# SHOW_DEMO_CONTENT=true

# ── Database (REQUIRED in production) ───────────────────────────────────────────────────
# PostgreSQL connection string, e.g. Neon, Supabase, Railway, RDS. Use the *pooled* URL on
# serverless hosts. Unset in development to use the embedded database (stored in .data/pglite).
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# Embedded dev database folder, or "memory" for a throw-away one.
# EMBEDDED_DB_DIR=.data/pglite
# Allow the embedded database / local photo storage outside development (tests only!).
# ALLOW_LOCAL_SERVICES=false

# ── Owner sign-in (run `npm run setup:owner` to create these) ───────────────────────────
# AUTH_SECRET=             # ≥ 32 random characters; signs session cookies
# OWNER_EMAIL=you@example.com
# OWNER_PASSWORD_HASH=     # scrypt hash — the password itself is never stored
# OWNER_TOTP_SECRET=       # two-factor secret (REQUIRED in production)
# AUTH_ALLOW_PASSWORD_ONLY=false   # escape hatch to waive two-factor in production (not recommended)

# ── Map (licensed provider; MapLibre is only the renderer) ──────────────────────────────
# Without a key the site uses a bundled country-level atlas (no streets/POIs).
# MapTiler (https://www.maptiler.com): create a key and RESTRICT IT BY DOMAIN in their dashboard,
# because the browser needs it to fetch tiles. This one is PUBLIC by design.
# MAPTILER_PUBLIC_KEY=
# MAPTILER_STYLE_ID=streets-v2      # or the id of your own branded style
# Alternatively any MapLibre-compatible style URL (Stadia, Protomaps, your own tile server…).
# MAP_STYLE_URL=
# If your style loads tiles/glyphs/sprites from extra origins, list them for the CSP (comma-separated).
# MAP_CSP_ORIGINS=https://tiles.example.com

# ── Geocoding / place search (owner dashboard only; SERVER-SIDE SECRET) ─────────────────
# Without a key the dashboard searches a built-in list of ~45 major cities.
# MAPTILER_GEOCODING_KEY=           # keep separate from the public key above

# ── Photo storage (REQUIRED in production) ──────────────────────────────────────────────
# local = files on this machine's disk (development only). s3 = any S3-compatible bucket:
# AWS S3, Cloudflare R2, Backblaze B2, MinIO, Supabase Storage (S3 API)…
STORAGE_DRIVER=local
# LOCAL_STORAGE_DIR=.data/uploads
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com   # omit for AWS S3
# S3_REGION=auto
# S3_BUCKET=oops-photos
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=https://cdn.example.com    # public/CDN URL that serves the bucket (no trailing slash)
# S3_FORCE_PATH_STYLE=false                      # true for MinIO and some S3 clones
# The bucket needs a CORS rule allowing PUT from SITE_URL (see docs/deployment.md).

# ── Logging ─────────────────────────────────────────────────────────────────────────────
# LOG_LEVEL=info   # debug | info | warn | error
